{
    "version": 6,
    "include": [
        "Base.json",
        "Os/Linux.json",
        "Os/Windows.json",
        "Generators/Make.json",
        "Generators/Ninja.json",
        "Generators/Msvc.json",
        "x64-linux-gcc.json",
        "x64-linux-llvm.json",
        "x64-windows-llvm.json"
    ],
    "configurePresets": [
        {
            "name": "dev-gcc",
            "displayName": "Developer Config with GCC-Debug",
            "inherits": [ "make", "base-config-debug","x64-linux-gcc-debug"]
        },
        {
            "name": "dev-clang",
            "displayName": "Developer Config with Clang-Debug",
            "inherits": [ "make", "base-config-debug","x64-linux-llvm-debug"]
        },
        {
            "name": "dev-release-gcc",
            "displayName": "Developer Config with GCC-Release",
            "inherits": [ "make", "base-config-release","x64-linux-gcc-release"]
        },
        {
            "name": "dev-release-clang",
            "displayName": "Developer Config with Clang-Release",
            "inherits": [ "make", "base-config-release","x64-linux-llvm-release"]
        },
        {
            "name": "dev-win-llvm-ninja",
            "displayName": "Developer Config with Ninja Generator (LLVM)-Debug",
            "inherits": [ "ninja","base-config-debug","x64-win-llvm-debug"]
        },
        {
            "name": "dev-win-release-llvm-ninja",
            "displayName": "Developer Config with Ninja Generator (LLVM)-Release",
            "inherits": [ "ninja","base-config-release","x64-win-llvm-release"]
        },
        {
            "name": "dev-win-llvm-msvc",
            "displayName": "Developer Config with MSVC Generator (LLVM)-Debug",
            "inherits": [ "msvc", "base-config-debug", "x64", "win" ]
        },
        {
            "name": "dev-win-release-llvm-msvc",
            "displayName": "Developer Config with MSVC Generator (LLVM)-Release",
            "inherits": [ "msvc", "base-config-release", "x64", "win" ]
        }
    ],
    "buildPresets": [
        {
            "name": "dev-gcc",
            "displayName": "Developer Build with GCC-Debug",
            "inherits": ["linux","build-debug"],
            "configurePreset": "dev-gcc"
        },
        {
            "name": "dev-clang",
            "displayName": "Developer Build with Clang-Debug",
            "inherits": ["linux","build-debug"],
            "configurePreset": "dev-clang"
        },
        {
            "name": "dev-release-gcc",
            "displayName": "Developer Build with GCC-Release",
            "inherits": ["linux","build-release"],
            "configurePreset": "dev-release-gcc"
        },
        {
            "name": "dev-release-clang",
            "displayName": "Developer Build with Clang-Release",
            "inherits": ["linux","build-release"],
            "configurePreset": "dev-release-clang"
        },
        {
            "name": "dev-win-llvm-ninja",
            "displayName": "Developer Build with Ninja Generator (LLVM)-Debug",
            "inherits": ["win","build-debug"],
            "configurePreset": "dev-win-llvm-ninja"
        },
        {
            "name": "dev-win-release-llvm-ninja",
            "displayName": "Developer Build with Ninja Generator (LLVM)-Release",
            "inherits": ["win","build-release"],
            "configurePreset": "dev-win-release-llvm-ninja"
        },
        {
            "name": "dev-win-llvm-msvc",
            "displayName": "Developer Build with MSVC Generator (LLVM)-Debug",
            "inherits": ["win","build-debug"],
            "configuration": "Debug",
            "configurePreset": "dev-win-llvm-msvc"
        },
        {
            "name": "dev-win-release-llvm-msvc",
            "displayName": "Developer Build with MSVC Generator (LLVM)-Release",
            "inherits": ["win","build-release"],
            "configuration": "Release",
            "configurePreset": "dev-win-release-llvm-msvc"
        }
    ]
}
