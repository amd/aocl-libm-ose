# Inherit global environment
Import('env')
from os.path import join as joinpath
import importlib.util
import os

# Load optimized_srcs without polluting sys.path
_spec = importlib.util.spec_from_file_location(
    'optimized_srcs',
    File('#src/optimized/optimized_srcs.py').abspath)
_mod = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_mod)
gather_optimized_srcs = _mod.gather_optimized_srcs
VRDA_UNARY_AVX512_FUNCS = _mod.VRDA_UNARY_AVX512_FUNCS
VRSA_UNARY_AVX512_FUNCS = _mod.VRSA_UNARY_AVX512_FUNCS
AVX512_VRDA_TEMPLATE = _mod.AVX512_VRDA_TEMPLATE
AVX512_VRSA_TEMPLATE = _mod.AVX512_VRSA_TEMPLATE

e = env.Clone()

# ---------------------------------------------------------------------------
# Inline-asm C sources from avx subdirectory (fmod, remainder, remainder_piby2*)
# ---------------------------------------------------------------------------
avxsrcs_objs = SConscript('avx/SConscript',
                         exports={'env': e},
                         duplicate=0)

# ---------------------------------------------------------------------------
# Assembly sources from avx2 subdirectory
# ---------------------------------------------------------------------------
avx2asm_objs = SConscript('avx2/SConscript',
                          exports={'env': e},
                          duplicate=0)

# ---------------------------------------------------------------------------
# ISA-specific compilation using -include to inject ISA header.
# Mirrors the pattern in src/isa/CMakeLists.txt.
#   avx2  (ISA_HAS_AVX512=0): COMMON_SRCS compiled with fma/avx2 flags
#   avx512(ISA_HAS_AVX512=1): COMMON_SRCS + AVX512_SRCS compiled with avx512 flags
# ---------------------------------------------------------------------------

avx2_srcs, avx512_srcs = gather_optimized_srcs(Glob)

isa_includes = [
    '#include',
    '#include/libm'
]

# ISA list: (name, define, has_avx512) — mirrors ALM_ISA_LIST in CMakeLists.txt
isa_list = [
    ('avx2',   'AVX2',   False),
    ('avx512', 'AVX512', True),
]

isa_header = joinpath(Dir('#src/isa').abspath, 'x86_isa.h')
if e['HOST_OS'] != 'win32':
    isa_common_flags = ['-mfma', '-O3', '-fPIC', '-flax-vector-conversions']
else:
    isa_common_flags = ['-mfma', '-O3']

isa_objs = []

for isa_name, isa_def, has_avx512 in isa_list:
    isa_env = e.Clone()

    # These rearrangements are not value-safe:
    #   (a ⊕ b) ⊕ c ⇒ a ⊕ (b ⊕ c)
    #   a ⊗ (b ⊕ c) ⇒ (a ⊗ b) ⊕ (a ⊕ c)
    # Strip -ffast-math (may be inherited from -Ofast) to prevent
    # unsafe floating-point reassociation in math library code.
    if '-ffast-math' in isa_env['CFLAGS']:
        isa_env['CFLAGS'].remove('-ffast-math')

    # Select source files and ISA-specific flags
    if has_avx512:
        srcs = avx512_srcs
        isa_flags = ['-mavx512f', '-mavx512dq']
    else:
        srcs = avx2_srcs
        isa_flags = ['-mavx2']

    # Set up compiler flags
    isa_cflags = ['-DALM_BUILD_' + isa_def + '=1']
    if e['HOST_OS'] != 'win32':
        isa_cflags.extend(['-include', isa_header])
    else:
        isa_cflags.extend(['/FI' + isa_header])

    isa_cflags.extend(isa_common_flags)
    isa_cflags.extend(isa_flags)

    isa_env.Append(
        CFLAGS = isa_cflags,
        CPPPATH = isa_includes,
    )

    # Build objects into ISA-specific subdirectory to avoid target conflicts
    for src in srcs:
        src_str = str(src)
        src_norm_path = os.path.normpath(src_str).replace('\\', '/')
        idx = src_norm_path.find('src/optimized/')
        if idx >= 0:
            rel = src_norm_path[idx + len('src/optimized/'):]
        else:
            rel = os.path.basename(src_norm_path)
        target = joinpath(isa_name, os.path.splitext(rel)[0])
        isa_objs.append(isa_env.StaticObject(target=target, source=src))

# ---------------------------------------------------------------------------
# AVX-512 template-based array wrapper compilation
#
# This loop compiles the vrda/vrsa template files multiple times, once for
# each function in the function lists. Each compilation receives:
#   -DALM_FUNC=<name>     : The function name (sin, cos, sinf, etc.)
#   -DALM_BUILD_AVX512=1  : Enables AVX-512 code paths in headers
#
# The template file uses PASTE(vrda_, ALM_FUNC) to construct the function
# name at compile time. For example, with -DALM_FUNC=sin, the template
# generates vrda_sin() which calls vrd8_sin() internally.
#
# This produces one object file per function (e.g., avx512/vrda_sin.o).
# ---------------------------------------------------------------------------
avx512_template_env = e.Clone()
if '-ffast-math' in avx512_template_env['CFLAGS']:
    avx512_template_env['CFLAGS'].remove('-ffast-math')

avx512_template_cflags = ['-DALM_BUILD_AVX512=1']
if e['HOST_OS'] != 'win32':
    avx512_template_cflags.extend(['-include', isa_header])
else:
    avx512_template_cflags.extend(['/FI' + isa_header])
avx512_template_cflags.extend(isa_common_flags)
avx512_template_cflags.extend(['-mavx512f', '-mavx512dq'])

vrda_template_src = File(joinpath('#src/optimized', AVX512_VRDA_TEMPLATE))
vrsa_template_src = File(joinpath('#src/optimized', AVX512_VRSA_TEMPLATE))

# Compile vrda (double) and vrsa (float) templates for each function
# Format: (prefix, template_source, function_list)
template_configs = [
    ('vrda', vrda_template_src, VRDA_UNARY_AVX512_FUNCS),
    ('vrsa', vrsa_template_src, VRSA_UNARY_AVX512_FUNCS),
]

# Outer loop: iterate over template configurations (vrda, vrsa)
for prefix, template_src, func_list in template_configs:
    # Inner loop: compile template once per function
    for func in func_list:
        tpl_env = avx512_template_env.Clone()
        tpl_env.Append(
            CFLAGS = avx512_template_cflags + ['-DALM_FUNC=' + func],
            CPPPATH = isa_includes,
        )
        target = joinpath('avx512', prefix + '_' + func)
        isa_objs.append(tpl_env.StaticObject(target=target, source=template_src))

objs = avxsrcs_objs + avx2asm_objs + isa_objs

Return('objs')
