# Inherit global environment
Import('env')
from os.path import join as joinpath
import importlib.util
import os

# Load optimized_srcs without polluting sys.path
_spec = importlib.util.spec_from_file_location(
    'optimized_srcs',
    File('#src/optimized/optimized_srcs.py').abspath)
_mod = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_mod)
gather_optimized_srcs = _mod.gather_optimized_srcs

e = env.Clone()

# ---------------------------------------------------------------------------
# Assembly sources from avx subdirectory
# ---------------------------------------------------------------------------
avxasm_objs = SConscript('avx/SConscript',
                         exports={'env': e},
                         duplicate=0)

# ---------------------------------------------------------------------------
# Assembly sources from avx2 subdirectory
# ---------------------------------------------------------------------------
avx2asm_objs = SConscript('avx2/SConscript',
                          exports={'env': e},
                          duplicate=0)

# ---------------------------------------------------------------------------
# ISA-specific compilation using -include to inject ISA header.
# Mirrors the pattern in src/isa/CMakeLists.txt.
#   avx2  (ISA_HAS_AVX512=0): COMMON_SRCS compiled with fma/avx2 flags
#   avx512(ISA_HAS_AVX512=1): COMMON_SRCS + AVX512_SRCS compiled with avx512 flags
# ---------------------------------------------------------------------------

avx2_srcs, avx512_srcs = gather_optimized_srcs(Glob)

isa_includes = [
    '#include',
    '#include/libm'
]

# ISA list: (name, define, has_avx512) — mirrors ALM_ISA_LIST in CMakeLists.txt
isa_list = [
    ('avx2',   'AVX2',   False),
    ('avx512', 'AVX512', True),
]

isa_header = joinpath(Dir('#src/isa').abspath, 'x86_isa.h')
if e['HOST_OS'] != 'win32':
    isa_common_flags = ['-mfma', '-O3', '-fPIC', '-flax-vector-conversions']
else:
    isa_common_flags = ['-mfma', '-O3']

isa_objs = []

for isa_name, isa_def, has_avx512 in isa_list:
    isa_env = e.Clone()

    # These rearrangements are not value-safe:
    #   (a ⊕ b) ⊕ c ⇒ a ⊕ (b ⊕ c)
    #   a ⊗ (b ⊕ c) ⇒ (a ⊗ b) ⊕ (a ⊕ c)
    # Strip -ffast-math (may be inherited from -Ofast) to prevent
    # unsafe floating-point reassociation in math library code.
    if '-ffast-math' in isa_env['CFLAGS']:
        isa_env['CFLAGS'].remove('-ffast-math')

    # Select source files and ISA-specific flags
    if has_avx512:
        srcs = avx512_srcs
        isa_flags = ['-mavx512f', '-mavx512dq']
    else:
        srcs = avx2_srcs
        isa_flags = ['-mavx2']

    # Set up compiler flags
    isa_cflags = ['-DALM_BUILD_' + isa_def + '=1']
    if e['HOST_OS'] != 'win32':
        isa_cflags.extend(['-include', isa_header])
    else:
        isa_cflags.extend(['/FI' + isa_header])

    isa_cflags.extend(isa_common_flags)
    isa_cflags.extend(isa_flags)

    isa_env.Append(
        CFLAGS = isa_cflags,
        CPPPATH = isa_includes,
    )

    # Build objects into ISA-specific subdirectory to avoid target conflicts
    for src in srcs:
        src_str = str(src)
        src_norm_path = os.path.normpath(src_str).replace('\\', '/')
        idx = src_norm_path.find('src/optimized/')
        if idx >= 0:
            rel = src_norm_path[idx + len('src/optimized/'):]
        else:
            rel = os.path.basename(src_norm_path)
        target = joinpath(isa_name, os.path.splitext(rel)[0])
        isa_objs.append(isa_env.StaticObject(target=target, source=src))

objs = avxasm_objs + avx2asm_objs + isa_objs

Return('objs')
