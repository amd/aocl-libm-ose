# Inherit global environment
Import('env')
from os.path import join as joinpath

e = env.Clone()

# Inline-asm C sources (converted from gas/*.S; see CMakeLists.txt avxsrcs)
avx_srcs = [
    'remainder_piby2.c',
    'remainder_piby2f.c',
    'remainder.c',
    'fmod.c',
]

# Set up include paths
p = joinpath(Dir('.').srcnode().path)
incpaths = [
    '#' + p,
    '#include',
    '#include/libm',
    '#src/isa/include',
]

# ISA_FLAGS equivalent: ISA-specific flags + ASAN + COVERAGE
# Mimics: ISA_FLAGS = ${isaflag} ${ASAN_FLAGS} ${COVERAGE_FLAGS}
isa_flags = [ ]

if e['HOST_OS'] != 'win32':
    isa_flags.extend(['-Wall', '-W', '-fPIC'])

e.Append(
    CPPPATH = incpaths,
    CCFLAGS = isa_flags,
)

# Build inline-asm C objects
objs = e.StaticObject(avx_srcs)

Return('objs')
