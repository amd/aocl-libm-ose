cmake_minimum_required(VERSION 3.23)
project(mpfr_mpc)

include(CheckIncludeFile)
include(FetchContent)

# Check for mpfr.h header file
check_include_file("mpfr.h" HAVE_MPFR_H)

# Check for MPFR
find_package(MPFR QUIET)
if(NOT MPFR_FOUND)
    message(STATUS "MPFR not found, fetching it...")
    FetchContent_Declare(
        mpfr
        GIT_REPOSITORY https://github.com/BrianGladman/mpfr.git
        GIT_TAG        master
    )
    FetchContent_MakeAvailable(mpfr)

    # Generate configuration files and build MPFR
    execute_process(COMMAND ./autogen.sh WORKING_DIRECTORY ${mpfr_SOURCE_DIR})
    execute_process(COMMAND ./configure WORKING_DIRECTORY ${mpfr_SOURCE_DIR})
    execute_process(COMMAND make WORKING_DIRECTORY ${mpfr_SOURCE_DIR})

    # Check again for mpfr.h after building
    check_include_file("${mpfr_SOURCE_DIR}/src/mpfr.h" HAVE_MPFR_H)
    if(HAVE_MPFR_H)
        set(MPFR_LIB mpfr)
    else()
        message(FATAL_ERROR "Failed to find mpfr.h after building MPFR.")
    endif()
else()
    set(MPFR_LIB MPFR::MPFR)
endif()

# Check for MPC
find_package(MPC QUIET)
if(NOT MPC_FOUND)
    message(STATUS "MPC not found, fetching it...")
    FetchContent_Declare(
        mpc
        GIT_REPOSITORY https://github.com/BrianGladman/mpc.git
        GIT_TAG        master
    )
    FetchContent_MakeAvailable(mpc)
    set(MPC_LIB mpc)
else()
    set(MPC_LIB MPC::MPC)
endif()

